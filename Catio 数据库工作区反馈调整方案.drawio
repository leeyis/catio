<mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Catio 数据库工作区 · 反馈调整方案" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="960" height="35" as="geometry"/></mxCell><mxCell id="subtitle" value="已确认布局｜数据对比归 Schema 菜单；沿用 Dawn / Amber / Grove tokens、现有字体和控件尺寸" style="text;html=1;align=left;fontSize=13;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="980" height="25" as="geometry"/></mxCell><mxCell id="explorer" value="" style="rounded=1;arcSize=3;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="320" height="440" as="geometry"/></mxCell><mxCell id="caption" value="对象资源管理器" style="text;html=1;align=left;fontSize=13;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="55" y="130" width="155" height="26" as="geometry"/></mxCell><mxCell id="commands" value="快捷操作" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="250" y="128" width="92" height="28" as="geometry"/></mxCell><mxCell id="connection" value="连接名 · 引擎　　　　　 刷新 / 收起" style="text;html=1;align=left;fontSize=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="55" y="170" width="287" height="36" as="geometry"/></mxCell><mxCell id="new-query" value="＋　新建查询" style="rounded=1;arcSize=8;html=1;align=center;verticalAlign=middle;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontColor=#3730A3;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="220" width="290" height="36" as="geometry"/></mxCell><mxCell id="query-note" value="按钮占满可用宽度；图标与文字整体居中" style="text;html=1;align=center;fontSize=11;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="50" y="260" width="300" height="24" as="geometry"/></mxCell><mxCell id="search" value="搜索表 / 视图…" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#94A3B8;align=left;spacingLeft=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="295" width="290" height="32" as="geometry"/></mxCell><mxCell id="tree" value="main　…&#10;　表&#10;　视图&#10;&#10;Schema 右键 / 省略号菜单&#10;　ER 图（保留）&#10;　数据对比（迁入）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#475569;spacing=5;" vertex="1" parent="1"><mxGeometry x="58" y="340" width="287" height="157" as="geometry"/></mxCell><mxCell id="status" value="已连接 · 当前连接" style="text;html=1;align=left;fontSize=11;fontColor=#64748B;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="55" y="515" width="280" height="25" as="geometry"/></mxCell><mxCell id="run-panel" value="运行分段按钮：只修复状态颜色，不改执行逻辑" style="swimlane;html=1;startSize=36;rounded=1;fillColor=#F8FAFC;swimlaneFillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#172554;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="115" width="640" height="200" as="geometry"/></mxCell><mxCell id="run-default" value="运行当前语句　 ▾" style="rounded=1;html=1;fillColor=#3730A3;strokeColor=#3730A3;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="185" width="230" height="38" as="geometry"/></mxCell><mxCell id="run-hover" value="运行当前语句　 ▾" style="rounded=1;html=1;fillColor=#4338CA;strokeColor=#4338CA;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="770" y="185" width="230" height="38" as="geometry"/></mxCell><mxCell id="hover-edge" value="悬浮箭头" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;fontSize=11;" edge="1" parent="1" source="run-default" target="run-hover"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="run-note" value="保持主题强调底色和 on-accent 前景；不被通用 icon-btn hover 的浅色背景覆盖。&#10;同时验收 hover、展开、键盘 focus、三个主题；下拉只打开菜单，不执行 SQL。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="425" y="244" width="590" height="52" as="geometry"/></mxCell><mxCell id="mapping-title" value="入口归属：删除“工具”，不是换个名字保留同一菜单" style="text;html=1;align=left;fontSize=15;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="400" y="347" width="640" height="32" as="geometry"/></mxCell><mxCell id="map-compare" value="Schema 右键 / 省略号&#10;数据对比" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="410" y="400" width="230" height="45" as="geometry"/></mxCell><mxCell id="compare-target" value="复用已有对比标签页&#10;选择两表后才比较" style="rounded=1;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontSize=13;fontColor=#3730A3;" vertex="1" parent="1"><mxGeometry x="770" y="400" width="250" height="45" as="geometry"/></mxCell><mxCell id="map-commands" value="标题右侧 · 快捷操作图标" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="410" y="470" width="230" height="45" as="geometry"/></mxCell><mxCell id="commands-target" value="原数据库命令面板&#10;保留 Ctrl / ⌘ + Shift + P" style="rounded=1;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontSize=13;fontColor=#3730A3;" vertex="1" parent="1"><mxGeometry x="770" y="470" width="250" height="45" as="geometry"/></mxCell><mxCell id="compare-edge" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;" edge="1" parent="1" source="map-compare" target="compare-target"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="commands-edge" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#64748B;" edge="1" parent="1" source="map-commands" target="commands-target"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="bounds" value="已实施：局部 hover 修复 + 新建查询居中 + Schema 菜单承接对比 + 标题快捷操作；原有功能门控不变。&#10;验收：三主题真实 hover、中心偏差 &lt; 0.01px、菜单/快捷键；95 项专项、1,891 项全量测试及构建通过。" style="rounded=1;html=1;whiteSpace=wrap;align=left;spacing=14;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#475569;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="1000" height="76" as="geometry"/></mxCell></root></mxGraphModel>